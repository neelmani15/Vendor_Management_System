# Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB URI (Update to your local or Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/fieldnerve

# Authentication Secrets
JWT_SECRET=super-secret-jwt-key-fieldnerve-development-min-32-chars
JWT_EXPIRES_IN=1d

# AI Intelligence Configuration
# Set to 'deterministic' to run 100% offline with zero API keys required
# Set to 'openai' if you wish to connect OpenAI GPT-4o-mini
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Origin
CORS_ORIGIN=http://localhost:5173
