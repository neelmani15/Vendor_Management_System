# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/fieldnerve

# Authentication
JWT_SECRET=super-secret-jwt-key-fieldnerve-development-min-32-chars
JWT_EXPIRES_IN=1d

# AI Intelligence Provider (options: 'deterministic' | 'openai')
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=http://localhost:5173
